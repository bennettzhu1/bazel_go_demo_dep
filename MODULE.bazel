module(
    name = "k8s-basics",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.53.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_helm", version = "0.17.0")
bazel_dep(name = "rules_oci", version = "2.0.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "gazelle", version = "0.45.0", repo_name = "bazel_gazelle")

GO_VERSION = "1.24.7"

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = GO_VERSION)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_default_attributes(
    build_file_generation = "on",
    directives = [
        "gazelle:proto disable",
    ],
)

# OCI (Docker) images
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Pull distroless base image (minimal, secure base image for static Go binaries)
oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/static-debian11",
    tag = "latest",  # Or use digest for hermetic/reproducible builds
    platforms = ["linux/amd64", "linux/arm64"],
)

use_repo(oci, "distroless_base")
