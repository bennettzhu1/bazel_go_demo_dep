load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

gazelle(
    name = "gazelle",
    external = "external",
)

# Go library
go_library(
    name = "k8s-basics_lib",
    srcs = ["main.go"],
    importpath = "github.com/bennettzhu/k8s-basics",
    visibility = ["//visibility:private"],
)

# Go binary
go_binary(
    name = "hello-k8s",
    embed = [":k8s-basics_lib"],
    visibility = ["//visibility:public"],
)

# Package the Go binary into a tar layer
pkg_tar(
    name = "app_layer",
    srcs = [":hello-k8s"],
    package_dir = "/",  # Put binary in root of image
)

# OCI image (this is your Docker image!)
# Usage: bazel build //:image
oci_image(
    name = "image",
    base = "@distroless_base",
    entrypoint = ["/hello-k8s"],
    tars = [":app_layer"],
    visibility = ["//visibility:public"],
)

# OCI tarball (for loading into Docker/Kind)
# Usage: bazel run //:load_image
# This loads the image directly into Docker/Kind
oci_load(
    name = "load_image",
    image = ":image",
    repo_tags = ["hello-k8s:latest"],
    visibility = ["//visibility:public"],
)
